PORT=3847
JWT_SECRET=replace-with-long-random-string
SQLITE_PATH=./data/server.sqlite
# Полный сброс БД (осторожно): остановите Node, затем RESET_DB_CONFIRM=yes npm run reset-db

# Уведомления в Telegram (продажи / расходы):
# 1) Скопируйте этот файл в backend/.env (именно .env, не только example).
# 2) TELEGRAM_BOT_TOKEN — от @BotFather
# 3) TELEGRAM_CHAT_ID — ваш chat id (например @userinfobot) или id группы
# 4) В личке с ботом нажмите /start, иначе бот не сможет слать сообщения.
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-or-group-id

# Ежедневный сводный отчёт в Telegram (cron, серверное время). Отключить: TELEGRAM_DAILY_REPORT_DISABLED=1
# TELEGRAM_DAILY_REPORT_CRON=0 21 * * *
# TELEGRAM_DAILY_REPORT_DISABLED=0

# Кто может открыть Mini App: через запятую Telegram user id (пусто = любой, кто прошёл подпись initData)
# TELEGRAM_ADMIN_IDS=123456789

# Только для разработки: тот же токен в admin/.env как VITE_DEV_TOKEN — обход Telegram-логина
# DEV_ADMIN_TOKEN=

# Вход в админку по логину/паролю (браузер):
# ADMIN_LOGIN=admin
# Вариант A — пароль в открытом виде (имеет смысл только по HTTPS):
# ADMIN_PASSWORD=измените-меня
# Вариант B — хеш bcrypt (если задан, используется вместо ADMIN_PASSWORD):
# сгенерировать: node -e "console.log(require('bcryptjs').hashSync('ваш-пароль',10))"
# ADMIN_PASSWORD_HASH=$2a$10$...

# Сид при первом запуске init-db (опционально)
SEED_PHONE=900000001
SEED_PIN=1234
SEED_NAME=Али
