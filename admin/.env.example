# Опционально. Если не задано — при `npm run dev` запросы идут через прокси Vite на localhost:3847 (без CORS).
# Обязательно задайте публичный HTTPS URL, если открываете Mini App с телефона (Telegram + ngrok).
# VITE_API_URL=http://localhost:3847

# Локальный вход без Telegram: тот же секрет, что DEV_ADMIN_TOKEN в backend/.env
# VITE_DEV_TOKEN=same-long-random-string-as-backend
