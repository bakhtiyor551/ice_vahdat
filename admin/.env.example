# Локально (`npm run dev`): можно не задавать — запросы через прокси Vite → localhost:3847.
# Или явно: VITE_API_URL=http://127.0.0.1:3847
#
# Продакшен (`npm run build`): если переменная НЕ задана, в сборку попадёт префикс "/api"
# (запросы на тот же хост: https://ваш-домен/api/admin/...). Нужен nginx:
#   location /api/ { proxy_pass http://127.0.0.1:3847/; ... }
# Если API на другом домене или порту — ОБЯЗАТЕЛЬНО укажите при сборке, например:
#   VITE_API_URL=https://ваш-домен.ru/api
#
# Telegram Mini App по HTTPS: задайте HTTPS URL API (не http://), иначе браузер заблокирует запросы.
# VITE_API_URL=https://example.com/api

# Локальный вход без Telegram: тот же секрет, что DEV_ADMIN_TOKEN в backend/.env
# VITE_DEV_TOKEN=same-long-random-string-as-backend

# Обычный вход: на бэкенде ADMIN_LOGIN / ADMIN_PASSWORD (или ADMIN_PASSWORD_HASH).
